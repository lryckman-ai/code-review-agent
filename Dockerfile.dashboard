# Dashboard image — build the Vue SPA, serve the static bundle with nginx.
# Deferred here from Phase C; the backend's 3-reviewers + api share the other
# Dockerfile. Build context is ./dashboard (see .dockerignore there).
#
#   docker build -f Dockerfile.dashboard -t codereview-dashboard:latest ./dashboard
#
# The SPA calls the API same-origin at /api/* (see VITE_API_BASE below), so in
# the cluster the ALB Ingress routes /api and /healthz to the api Service and
# everything else to this nginx.

# ---- build stage ---------------------------------------------------------
FROM node:24-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Vite inlines import.meta.env.VITE_* at build time. Empty base => the fetch
# client issues relative URLs (/api/runs, /api/stats/summary, ...), which the
# ALB Ingress path-routes to the api Service. `vite build` runs in production
# mode and picks this file up.
RUN printf 'VITE_API_BASE=\n' > .env.production \
 && npm run build-only

# ---- runtime stage ------------------------------------------------------
FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
