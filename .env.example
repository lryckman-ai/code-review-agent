# Local LLM endpoint (OpenAI-compatible API — vLLM, Ollama, etc.)
OPENAI_CHAT_LLM_NAME=gpt-4o
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key-here

# A2A reviewer service locations — each reviewer is its own host:port.
# Defaults to localhost:800x for local/dev use (single-machine, run_servers.py).
# In K8s these are set per-container to the Service DNS name, e.g.
# SECURITY_HOST=security-reviewer, PERFORMANCE_HOST=performance-reviewer, etc.
SECURITY_HOST=localhost
SECURITY_PORT=8001
PERFORMANCE_HOST=localhost
PERFORMANCE_PORT=8002
DEPENDENCY_HOST=localhost
DEPENDENCY_PORT=8003

# LangSmith tracing (optional — remove or leave blank to disable)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=codereview-agent

# Shadow scoring — judge model for async quality evaluation
OPENAI_JUDGE_MODEL=gpt-4o
SHADOW_SCORE_PROBABILITY=0.10
SHADOW_SCORE_THRESHOLD=0.70

# GitHub webhook (Phase F, webhook.py) — POST /api/webhook/github
# GITHUB_TOKEN: fine-grained PAT, "Pull requests: Read and write" on the repo
# GITHUB_WEBHOOK_SECRET: shared secret GitHub HMAC-signs each delivery with —
#   generate with `openssl rand -hex 32`, paste the same value into the
#   GitHub webhook's "Secret" field
# GITHUB_ALLOWED_REPO: "owner/repo" this instance will act on; anything else
#   is ignored
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_ALLOWED_REPO=owner/repo
